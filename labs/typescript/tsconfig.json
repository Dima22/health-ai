{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmitOnError": true,
    "skipLibCheck": true,
    "types": ["node"],
    "typeRoots": [
      "../../node_modules/@types",
      "../../server/node_modules/@types"
    ],
    "rootDir": ".",
    "outDir": "./dist"
  },
  "include": ["*.mts"],
  "exclude": ["dist"]
}